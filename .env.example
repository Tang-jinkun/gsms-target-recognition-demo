# `scripts/start_docker_gsms.sh` creates .env and generates both secrets.
# Never change GSMS_FERNET_KEY after saving Provider API keys.
GSMS_FERNET_KEY=
GSMS_AGENT_PROXY_TOKEN=

GSMS_BACKEND_BIND=127.0.0.1
GSMS_BACKEND_PORT=8000
GSMS_FRONTEND_BIND=0.0.0.0
GSMS_FRONTEND_PORT=3000

# Agent worker intent classifier defaults to the same GSMS Provider proxy/model
# as the main LLM. Set these only to override or disable that fallback.
INVEST_AGENT_INTENT_CLASSIFIER_MODEL=
INVEST_AGENT_INTENT_CLASSIFIER_BASE_URL=
INVEST_AGENT_INTENT_CLASSIFIER_API_KEY=
INVEST_AGENT_DISABLE_INTENT_CLASSIFIER=0
