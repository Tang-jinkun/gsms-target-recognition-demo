GSMS_URL=http://127.0.0.1:8000
GSMS_SCENE_ID=
INVEST_AGENT_WORKSPACE=.

# The model ID and Base URL may be omitted when a default GSMS LLM Provider exists.
INVEST_AGENT_MODEL=
INVEST_AGENT_BASE_URL=

# Secrets are intentionally not returned by the GSMS settings API.
INVEST_AGENT_API_KEY=
INVEST_AGENT_MAX_TURNS=30

# Required when using the server-side GSMS Provider proxy.
GSMS_AGENT_PROXY_TOKEN=
